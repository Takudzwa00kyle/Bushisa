APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bushisa_db
DB_USER=root
DB_PASS=
DB_PASSWORD=
# Production/Azure connections require verified TLS. Override with a CA bundle
# containing Azure MySQL's current trusted roots if the system bundle lacks them.
DB_SSL_CA=

MAIL_PROVIDER=fake
MAIL_FROM_ADDRESS=verification@bushisa.local
MAIL_FROM_NAME=Bushisa
MAIL_REPLY_TO=verification@bushisa.local
# SMTP is used only when MAIL_PROVIDER=smtp. Use the exact Azure SMTP username
# and the Entra application client secret VALUE, not its Secret ID.
SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
# Separate encryption key: base64 encoding of 32 random bytes. Never commit it.
MAIL_OUTBOX_KEY=
# Reset issuance is disabled until migration 016, the compatible dispatcher,
# reviewed abuse limits and rollout gates are ready. Blank throttle fields are
# intentional: Q47's suggested resend numbers were not owner-approved.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=
PASSWORD_RESET_MAX_REQUESTS_PER_DAY=
STUDENT_EMAIL_DOMAIN_ALLOWLIST=students.nust.ac.zw

SIGNUP_CODE_LENGTH=6
SIGNUP_CODE_TTL_SECONDS=600
SIGNUP_CODE_MAX_ATTEMPTS=5
SIGNUP_CODE_HMAC_KEY=replace-with-secret-key-material

BUSHISA_ALLOW_RUNTIME_DDL=true
