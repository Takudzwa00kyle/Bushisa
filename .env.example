APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bushisa_db
DB_USER=root
DB_PASS=
DB_PASSWORD=

MAIL_PROVIDER=fake
MAIL_FROM_ADDRESS=verification@bushisa.local
MAIL_FROM_NAME=Bushisa
